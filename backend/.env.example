DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_username
DB_PASSWORD=
PORT=5050

# Signs the session tokens. REQUIRED — the server refuses to sign a token
# without it rather than falling back to a default that anyone reading this
# repository could use to forge a login.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a sign-in lasts. Roughly one working day.
JWT_EXPIRES_IN=12h

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_key_here

# Where uploaded receipts and generated files are stored.
# local = backend/uploads on this machine (development + demos)
# azure = Azure Blob Storage (production)
STORAGE_DRIVER=local

# Only needed when STORAGE_DRIVER=azure (also: npm install @azure/storage-blob)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=receipts