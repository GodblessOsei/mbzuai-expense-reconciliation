DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_username
DB_PASSWORD=
PORT=5050

# Browser origins allowed to call this API, comma-separated. Local dev needs
# nothing here; in production set it to the deployed frontend URL.
CORS_ORIGINS=http://localhost:5173
# Also allow https://<anything>.vercel.app so branch previews work.
CORS_ALLOW_VERCEL_PREVIEWS=false

# Signs the session tokens. REQUIRED — the server refuses to sign a token
# without it rather than falling back to a default that anyone reading this
# repository could use to forge a login.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a sign-in lasts. Roughly one working day.
JWT_EXPIRES_IN=12h

# Receipt OCR, via OpenRouter (model openai/gpt-4o-mini).
OPENROUTER_API_KEY=

# Where uploaded receipts and generated files are stored.
# local = backend/uploads on this machine (development + demos)
# s3    = any S3-compatible object store (production; Supabase Storage)
# Render's disk is ephemeral, so production MUST NOT use local.
STORAGE_DRIVER=local

# Only needed when STORAGE_DRIVER=s3. From Supabase:
#   Storage -> S3 Connection for the endpoint and region,
#   Storage -> S3 Access Keys to create the key pair.
S3_BUCKET=receipts
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=